# digital-employee case 的环境变量样板(数字员工阿J:话题隔离 + OAuth + 记忆)。
# 用法:
#   cp scenarios/feishu-bot/cases/digital-employee/env.example ~/.arkagent/cases/digital-employee/config.env
#   编辑真实值,然后 `python3 -m arkagent run --case digital-employee`
# CLI 启动时会自动加载该文件。

# ---- 方舟鉴权(必填) ----
ARK_API_KEY="your-ark-api-key"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# ---- 飞书 Bot(必填,`arkagent init` 扫码后自动写入) ----
FEISHU_APP_ID="cli_xxxx"
FEISHU_APP_SECRET="xxxx"

# ---- 数字员工 MA 资源(必填,initialize_digital_employee.py 输出) ----
# 装了 lark-cli 的 Environment(优先 GROUP_BOT_ENVIRONMENT_ID,缺失回退 ARK_ENVIRONMENT_ID)
GROUP_BOT_ENVIRONMENT_ID="env-xxxx"
# 群聊数字员工 Agent id
GROUP_BOT_AGENT_ID="agent-xxxx"

# ---- 可选 ----
# 挂载短期 tenant token 的 Vault(不填即不启用 lark-cli 定位能力)
GROUP_BOT_LARK_VAULT_ID=""
# 会话/话题状态库(缺省会写到 case 独立目录下的 topic_bot_sessions.db)
TOPIC_BOT_DB_PATH=""
# serial(默认,按话题串行) 或 native-queue(方舟原生队列)
DIGITAL_EMPLOYEE_EXECUTION_MODE="serial"
# 会话超时毫秒
SESSION_TIMEOUT_MS="600000"
# 白名单(open_id 与 user_id 二选一或同时用;留空=不限)
AUTHORIZED_OPEN_IDS=""
AUTHORIZED_USER_IDS=""
