# 配置路径：~/.arkagent/cases/seedance/config.env
# 可先 arkagent init --case seedance 扫码创建独立 Bot，再补模型配置。
# 已有 Bot 时填写实际凭据；同一 App 的其他 Gateway 必须先停止。
ARK_API_KEY="${ARK_API_KEY}"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
FEISHU_APP_ID="${FEISHU_APP_ID}"
FEISHU_APP_SECRET="${FEISHU_APP_SECRET}"

# 模型从控制台 Seedance Managed Agent 创建页选择，必须先开通。
# 官方教程示例：doubao-seed-2-1-lite-260915 /
# doubao-seedream-5-0-pro-260628 / doubao-seedance-2-5-260628。
SEEDANCE_AGENT_MODEL_ID="${SEEDANCE_AGENT_MODEL_ID}"
SEEDANCE_IMAGE_MODEL_ID="${SEEDANCE_IMAGE_MODEL_ID}"
SEEDANCE_VIDEO_MODEL_ID="${SEEDANCE_VIDEO_MODEL_ID}"

# update_ma.sh 成功后自动写回这两个 ID。已有 Seedance Agent 可手动填写。
SEEDANCE_AGENT_ID="${SEEDANCE_AGENT_ID}"
SEEDANCE_ENVIRONMENT_ID="${SEEDANCE_ENVIRONMENT_ID}"

# 视频任务使用 30 分钟超时；超时不会自动重新提交任务。
SEEDANCE_SESSION_TIMEOUT_MS="1800000"
SEEDANCE_ARTIFACT_POLL_ATTEMPTS="10"
SEEDANCE_ARTIFACT_POLL_INTERVAL_MS="2000"
# 超过回传上限的文件提供有时效的下载链接；可按飞书实际限制调整。
SEEDANCE_MAX_INPUT_BYTES="31457280"
SEEDANCE_MAX_OUTPUT_BYTES="31457280"
# 空表示允许 Bot 可见范围内的用户；可填空格或逗号分隔的 open_id。
SEEDANCE_AUTHORIZED_OPEN_IDS=""
