# topic6 case 的环境变量样板。
# 用法:
#   cp scenarios/feishu-bot/cases/topic6/env.example ~/.arkagent/cases/topic6/config.env
#   编辑真实值,然后 `python3 -m arkagent run --case topic6`
# CLI 启动时会自动加载该文件。

# ---- 方舟鉴权(必填) ----
ARK_API_KEY="your-ark-api-key"
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# ---- 飞书 Bot(必填,`arkagent init --topic6` 扫码后自动写入) ----
FEISHU_APP_ID="cli_xxxx"
FEISHU_APP_SECRET="xxxx"

# ---- topic6 MA 资源(必填,由 cases/topic6/ma-resources/create_all.sh 输出) ----
TOPIC6_COORDINATOR_AGENT_ID="agent-xxxx"
TOPIC6_ENVIRONMENT_ID="env-xxxx"

# ---- 可选 ----
# HITL 长任务状态库路径;缺省 ./data/topic6_pipeline.db
TOPIC6_PIPELINE_DB_PATH=""
# Session outputs 本地同步目录;缺省 cases/topic6/data/artifacts
TOPIC6_ARTIFACT_SYNC_DIR=""
# 方舟 Files API 轮询间隔(秒)
TOPIC6_ARTIFACT_POLL_INTERVAL_SEC="60"
# topic6 长任务的 Memory Store id(用于 coordinator 读写记忆);留空表示不挂载
TOPIC6_MEMORY_STORE_ID=""
# 可选的共享 Vault；妙搭用户 OAuth 不填这里，由 authorize_miaoda_user.py
# 自动创建每用户独立 Vault，并在 Session 创建时按消息发送者挂载
ARK_VAULT_ID=""
# 允许触发的飞书 open_id 白名单(逗号分隔;留空=不限)
AUTHORIZED_OPEN_IDS=""
