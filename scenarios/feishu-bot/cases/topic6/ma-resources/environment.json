{
  "name": "topic6-prod-env",
  "description": "topic6 社媒热点周刊生产环境。承载 Producer 主线 14 步 pipeline。",
  "config": {
    "type": "cloud",
    "networking": {
      "type": "unrestricted"
    },
    "packages": {
      "pip": [
        "pandas>=2.0",
        "openpyxl>=3.1",
        "requests>=2.31",
        "pyyaml>=6.0",
        "numpy>=1.24",
        "openai>=1.0",
        "python-dateutil>=2.8",
        "lunardate>=0.2.2"
      ]
    },
    "env": {
      "TZ": "Asia/Shanghai",
      "PYTHONUNBUFFERED": "1",
      "DATAHUB_ENDPOINT": "${DATAHUB_ENDPOINT}",
      "DATAHUB_API_KEY": "${DATAHUB_API_KEY}",
      "LARK_APP_ID": "${LARK_APP_ID}",
      "LARK_APP_SECRET": "${LARK_APP_SECRET}",
      "BLUEAI_API_KEY": "${BLUEAI_API_KEY}",
      "MIAODA_TOKEN": "${MIAODA_TOKEN}",
      "ARK_API_KEY": "${ARK_API_KEY}",
      "ARK_BASE_URL": "${ARK_BASE_URL}",
      "DATAHUB_MODEL_ID": "Doubao-Seed-Evolving",
      "C2_CHAT_MODEL_ID": "doubao-seed-evolving",
      "EMBEDDING_MODEL_ID": "doubao-embedding-vision-251215"
    }
  }
}
